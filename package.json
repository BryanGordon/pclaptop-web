{
  "name": "pclaptop-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PC Laptop e-commerce monorepo (Astro front + Go API)",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "npm run dev -w @pclaptop/web",
    "build": "npm run build -w @pclaptop/web",
    "preview": "npm run preview -w @pclaptop/web",
    "check": "npm run check -w @pclaptop/web",
    "lint": "npm run lint -w @pclaptop/web",
    "lint:fix": "npm run lint:fix -w @pclaptop/web"
  }
}
