{
  "name": "pclaptop-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PC Laptop e-commerce monorepo (Astro front + Go API)",
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @pclaptop/web dev",
    "build": "pnpm --filter @pclaptop/web build",
    "preview": "pnpm --filter @pclaptop/web preview",
    "check": "pnpm --filter @pclaptop/web check",
    "lint": "pnpm --filter @pclaptop/web lint",
    "lint:fix": "pnpm --filter @pclaptop/web lint:fix"
  }
}
