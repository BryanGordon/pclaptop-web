---
import logo from '@media/logo.jpg';
import { NAV_ITEMS, PRODUCT_CATEGORIES, SITE_NAME, SITE_TAGLINE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="footer__inner container">
		<div class="footer__brand">
			<div class="footer__brand-top">
				<img class="footer__logo" src={logo.src} width="52" height="52" alt={SITE_NAME} />
				<div>
					<p class="footer__name">{SITE_NAME}</p>
					<p class="footer__tagline">{SITE_TAGLINE}</p>
				</div>
			</div>
			<p class="footer__partner">
				<span class="footer__partner-badge">ASUS Partner</span>
				Somos partners autorizados ASUS: equipos originales, garantía oficial y soporte técnico
				especializado.
			</p>
		</div>

		<nav class="footer__column" aria-labelledby="footer-nav-title">
			<h2 class="footer__title" id="footer-nav-title">Navegación</h2>
			<ul class="footer__list">
				{
					NAV_ITEMS.map((item) => (
						<li>
							<a class="footer__link" href={item.href}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<nav class="footer__column" aria-labelledby="footer-categories-title">
			<h2 class="footer__title" id="footer-categories-title">Productos</h2>
			<ul class="footer__list">
				{
					PRODUCT_CATEGORIES.map((item) => (
						<li>
							<a class="footer__link" href={item.href}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="footer__column">
			<h2 class="footer__title">Contacto</h2>
			<ul class="footer__list">
				<li><a class="footer__link" href="tel:+000000000">+00 000 000 000</a></li>
				<li><a class="footer__link" href="mailto:ventas@pclaptop.com">ventas@pclaptop.com</a></li>
				<li><a class="footer__link" href="/contacto">Ver direcciones</a></li>
			</ul>
		</div>
	</div>

	<div class="footer__bottom container">
		<p>© {year} {SITE_NAME}. Todos los derechos reservados.</p>
		<p>Partner autorizado ASUS · Equipos con garantía oficial</p>
	</div>
</footer>

<style>
	.footer {
		background-color: var(--color-card);
		color: var(--color-card-text);
		padding-top: 56px;
	}

	.footer__inner {
		display: grid;
		grid-template-columns: 1.5fr 1fr 1fr 1fr;
		gap: var(--gap-lg);
		padding-bottom: 40px;
	}

	.footer__brand-top {
		display: flex;
		align-items: center;
		gap: 14px;
		margin-bottom: 20px;
	}

	.footer__logo {
		width: 52px;
		height: 52px;
		object-fit: cover;
		border-radius: var(--radius-image);
	}

	.footer__name {
		color: var(--color-card-title);
		font-family: var(--font-display);
		font-size: var(--text-lg);
		font-weight: 700;
		line-height: 1.2;
	}

	.footer__tagline {
		color: var(--color-card-muted);
		font-size: var(--text-sm);
	}

	.footer__partner {
		display: grid;
		gap: 10px;
		max-width: 34ch;
		color: var(--color-card-text);
		font-size: var(--text-sm);
		line-height: 1.6;
	}

	.footer__partner-badge {
		display: inline-flex;
		align-items: center;
		width: fit-content;
		padding: 6px 14px;
		background-color: var(--color-card-title);
		border-radius: var(--radius-pill);
		color: var(--color-text);
		font-family: var(--font-display);
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.footer__title {
		margin-bottom: 16px;
		color: var(--color-card-title);
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.footer__list {
		display: grid;
		gap: 10px;
	}

	.footer__link {
		color: var(--color-card-text);
		font-size: var(--text-sm);
		transition: color var(--transition-base);
	}

	.footer__link:hover {
		color: var(--color-card-title);
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.footer__bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--gap);
		padding-block: 24px;
		border-top: 1px solid rgb(1 13 38 / 16%);
		color: var(--color-card-muted);
		font-size: var(--text-sm);
	}
</style>
