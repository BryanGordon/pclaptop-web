---
import { HOME_BANNERS } from '../data/banners'
---

<section class="section bento" aria-labelledby="bento-title">
	<div class="container">
		<header class="section__header">
			<div class="bento__intro">
				<p class="eyebrow">Destacados</p>
				<h2 id="bento-title">Líneas destacadas</h2>
			</div>
			<a class="btn btn--ghost" href="/pcs">Ver todas las laptops</a>
		</header>

		<ul class="bento__grid" data-bento-grid>
			{
				HOME_BANNERS.map((banner) => (
					<li class:list={['bento__item', `bento__item--${banner.size}`]} data-bento>
						<a class="card bento__card" href={banner.href}>
							<div class="bento__media">
								<img
									class="bento__image"
									src={banner.image.src}
									width={banner.image.width}
									height={banner.image.height}
									alt={banner.imageAlt}
									loading="lazy"
									decoding="async"
								/>
							</div>

							<div class="bento__caption">
								<h3 class="bento__brand">{banner.brand}</h3>
							</div>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<script>
import { gsap } from 'gsap'
import { ScrollTrigger } from 'gsap/ScrollTrigger'

gsap.registerPlugin(ScrollTrigger)

const grid = document.querySelector<HTMLElement>('[data-bento-grid]')
const items = document.querySelectorAll<HTMLElement>('[data-bento]')
const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

if (grid && items.length > 0 && !reduceMotion) {
  gsap.from(items, {
    y: 28,
    opacity: 0,
    duration: 0.7,
    stagger: 0.1,
    ease: 'power3.out',
    scrollTrigger: {
      trigger: grid,
      start: 'top 85%',
      once: true,
    },
  })
}
</script>

<style>
	.bento__intro {
		display: grid;
		gap: 12px;
	}

	.bento__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--gap);
	}

	.bento__item {
		display: flex;
	}

	.bento__item--wide {
		grid-column: 1 / -1;
	}

	.bento__card {
		flex: 1;
	}

	.bento__media {
		position: relative;
		aspect-ratio: 2 / 1;
		padding: 20px 20px 0;
		overflow: hidden;
	}

	.bento__image {
		position: absolute;
		top: 20px;
		left: 20px;
		width: calc(100% - 40px);
		height: calc(100% - 20px);
		object-fit: cover;
		object-position: center;
		border-radius: var(--radius-image);
		transition: transform var(--transition-base);
	}

	.bento__card:hover .bento__image {
		transform: scale(1.03);
	}

	.bento__caption {
		padding: 16px 20px;
	}

	.bento__brand {
		font-size: var(--text-lg);
		line-height: 1.2;
	}

	.bento__item--wide .bento__brand {
		font-size: var(--text-xl);
	}
</style>
