---
import { CATEGORY_TILES } from '../data/categories'
---

<section class="section categories" aria-labelledby="categories-title">
	<div class="container">
		<header class="section__header">
			<div class="categories__intro">
				<p class="eyebrow">Categorías</p>
				<h2 id="categories-title">Explora por categoría</h2>
			</div>
			<a class="btn btn--ghost-emphasis" href="/otros-productos#todos-los-productos">Ver todos los productos</a>
		</header>

		<ul class="categories__list" data-categories-list>
			{
				CATEGORY_TILES.map((category) => (
					<li class="categories__item" data-category>
						<a class="category" href={category.href}>
							<img
								class="category__image"
								src={category.image.src}
								width={category.image.width}
								height={category.image.height}
								alt={category.imageAlt}
								loading="lazy"
								decoding="async"
							/>
							<span class="category__label">{category.label}</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<script>
import { gsap } from 'gsap'
import { ScrollTrigger } from 'gsap/ScrollTrigger'

gsap.registerPlugin(ScrollTrigger)

const list = document.querySelector<HTMLElement>('[data-categories-list]')
const tiles = document.querySelectorAll<HTMLElement>('[data-category]')
const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

if (list && tiles.length > 0 && !reduceMotion) {
  gsap.from(tiles, {
    y: 24,
    opacity: 0,
    duration: 0.6,
    stagger: 0.08,
    ease: 'power3.out',
    scrollTrigger: {
      trigger: list,
      start: 'top 88%',
      once: true,
    },
  })
}
</script>

<style>
	.categories__intro {
		display: grid;
		gap: 12px;
	}

	.categories__list {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 20px;
	}

	.categories__item {
		width: 250px;
	}

	.category {
		position: relative;
		display: block;
		aspect-ratio: 1 / 1;
		overflow: hidden;
		border-radius: var(--radius-card);
		background-color: var(--color-surface);
		transition: box-shadow var(--transition-base);
	}

	.category:hover {
		box-shadow: var(--shadow-card);
	}

	.category__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--transition-base);
	}

	.category:hover .category__image {
		transform: scale(1.06);
	}

	.category__label {
		position: absolute;
		inset: auto 0 0 0;
		padding: 40px 14px 14px;
		background: linear-gradient(0deg, rgb(1 13 38 / 90%) 0%, rgb(1 13 38 / 0%) 100%);
		color: var(--color-text);
		font-family: var(--font-display);
		font-size: var(--text-base);
		font-weight: 600;
		line-height: 1.2;
		transition: color var(--transition-base);
	}

	.category:hover .category__label {
		color: var(--color-heading);
	}
</style>
