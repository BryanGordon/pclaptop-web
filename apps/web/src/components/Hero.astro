---
import heroImage from '@media/banners/hero_pc.webp';
---

<section class="hero" aria-labelledby="hero-title">
	<figure class="hero__media" data-hero-media>
		<img
			class="hero__image"
			src={heroImage.src}
			width={heroImage.width}
			height={heroImage.height}
			alt="Laptop de alto rendimiento sobre un escritorio con iluminación azul"
			fetchpriority="high"
			decoding="async"
		/>
	</figure>
	<div class="hero__scrim" aria-hidden="true"></div>

	<div class="hero__inner container">
		<div class="hero__content" data-hero-content>
			<h1 id="hero-title">Tu próximo equipo empieza aquí</h1>
			<p class="hero__lead">
				Laptops, monitores, componentes y repuestos seleccionados para trabajar, crear y jugar sin
				compromisos. Configuramos tu equipo con asesoría real.
			</p>
			<div class="hero__actions">
				<a class="btn btn--primary" href="/pcs">Ver productos</a>
			</div>
		</div>
	</div>
</section>

<script>
import { gsap } from 'gsap'

const content = document.querySelector<HTMLElement>('[data-hero-content]')
const media = document.querySelector<HTMLElement>('[data-hero-media]')
const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

if (content && media && !reduceMotion) {
  gsap
    .timeline({ defaults: { ease: 'power3.out', duration: 0.7 } })
    .from(media, { opacity: 0, scale: 1.06, duration: 1.1 })
    .from(content.children, { y: 24, opacity: 0, stagger: 0.08 }, '<0.35')
}
</script>

<style>
	.hero {
		position: relative;
		display: flex;
		align-items: center;
		min-height: 620px;
		overflow: hidden;
		padding-block: 88px 72px;
	}

	.hero__media {
		position: absolute;
		inset: 0;
		z-index: 0;
		margin: 0;
	}

	.hero__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 42%;
	}

	.hero__scrim {
		position: absolute;
		inset: 0;
		z-index: 1;
		background:
			linear-gradient(
				90deg,
				rgb(1 13 38 / 92%) 0%,
				rgb(1 13 38 / 82%) 34%,
				rgb(1 13 38 / 34%) 68%,
				rgb(1 13 38 / 48%) 100%
			),
			linear-gradient(0deg, rgb(1 13 38 / 55%) 0%, transparent 45%);
		pointer-events: none;
	}

	.hero__inner {
		position: relative;
		z-index: 2;
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
		align-items: center;
		gap: 64px;
	}

	.hero__content {
		display: grid;
		gap: 22px;
		justify-items: start;
	}

	.hero__lead {
		max-width: 48ch;
		color: var(--color-text-muted);
		font-size: var(--text-lg);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 4px;
	}
</style>
