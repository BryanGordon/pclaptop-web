---
export interface Props {
	title: string;
	description?: string;
	eyebrow?: string;
}

const { title, description, eyebrow } = Astro.props;
---

<header class="page-header container">
	{eyebrow && <p class="eyebrow">{eyebrow}</p>}
	<h1>{title}</h1>
	{description && <p class="lead">{description}</p>}
</header>

<style>
	.page-header {
		display: grid;
		gap: 16px;
		justify-items: start;
		padding-block: 72px 32px;
	}

	.page-header .lead {
		max-width: 60ch;
	}
</style>
