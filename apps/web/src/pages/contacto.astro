---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { CONTACT } from '../data/contact';
---

<BaseLayout title="Contacto" description="Direcciones, teléfonos y formulario de contacto.">
	<PageHeader
		eyebrow="Contáctanos"
		title="Contacto"
		description="Visítanos en tienda, llámanos o escríbenos y te respondemos a la brevedad."
	/>

	<div class="container contact">
		<section class="contact__location" aria-label="Ubicación y datos de contacto">
			<iframe
				class="map"
				src={CONTACT.mapEmbedSrc}
				title={`Ubicación de PC Laptop en ${CONTACT.address}`}
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"
			></iframe>

			<dl class="contact__details">
				<div class="card card--glow contact__card">
					<dt>Dirección</dt>
					<dd>
						{CONTACT.address}
						<a class="contact__link" href={CONTACT.mapHref} target="_blank" rel="noopener noreferrer">
							Ver en el mapa
						</a>
					</dd>
				</div>

				<div class="card card--glow contact__card">
					<dt>Teléfono</dt>
					<dd><a class="contact__link" href={CONTACT.phoneHref}>{CONTACT.phone}</a></dd>
				</div>

				<div class="card card--glow contact__card">
					<dt>Correo</dt>
					<dd><a class="contact__link" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></dd>
				</div>
			</dl>
		</section>

		<section class="contact__form" aria-labelledby="contact-form-title">
			<header class="section__header">
				<div class="contact__intro">
					<p class="eyebrow">Formulario</p>
					<h2 id="contact-form-title">Escríbenos</h2>
				</div>
			</header>

			<form class="form">
				<div class="form__field">
					<label class="form__label" for="contact-name">Nombre</label>
					<input
						class="form__control"
						id="contact-name"
						name="name"
						type="text"
						autocomplete="name"
						required
					/>
				</div>

				<div class="form__field">
					<label class="form__label" for="contact-email">Correo</label>
					<input
						class="form__control"
						id="contact-email"
						name="email"
						type="email"
						autocomplete="email"
						required
					/>
				</div>

				<div class="form__field">
					<label class="form__label" for="contact-phone">
						Teléfono <span class="form__optional">(opcional)</span>
					</label>
					<input
						class="form__control"
						id="contact-phone"
						name="phone"
						type="tel"
						autocomplete="tel"
					/>
				</div>

				<div class="form__field form__field--full">
					<label class="form__label" for="contact-message">Mensaje</label>
					<textarea
						class="form__control form__control--area"
						id="contact-message"
						name="message"
						rows="5"
						required></textarea>
				</div>

				<div class="form__actions">
					<button class="btn btn--primary btn--night" type="button">Enviar mensaje</button>
					<p class="form__note">El envío se conecta cuando esté listo el backend.</p>
				</div>
			</form>
		</section>
	</div>
</BaseLayout>

<style>
	.contact {
		display: grid;
		gap: var(--section-space);
		padding-bottom: var(--section-space);
	}

	.contact__location {
		display: grid;
		gap: var(--gap);
	}

	.map {
		width: 100%;
		height: 380px;
		border: 0;
		border-radius: var(--radius-card);
		background-color: var(--color-surface);
	}

	.contact__details {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--gap);
	}

	.contact__card {
		gap: 6px;
		padding: 24px;
	}

	.contact__card dt {
		color: var(--color-card-title);
		font-family: var(--font-display);
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.contact__card dd {
		color: var(--color-card-text);
		line-height: 1.55;
	}

	.contact__link {
		display: block;
		margin-top: 8px;
		color: var(--color-card-title);
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.contact__card a.contact__link:hover {
		text-decoration-thickness: 2px;
	}

	.contact__intro {
		display: grid;
		gap: 12px;
	}

	/* Field look, states and the full-width pieces come from `global.css`; only
	   the column layout is this page's own. */
	.form {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}
</style>
