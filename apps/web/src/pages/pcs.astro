---
import BaseLayout from '../layouts/BaseLayout.astro';
import Catalog from '../components/Catalog.astro';
import ProductCard from '../components/ProductCard.astro';
import { PRODUCTS } from '../data/products'

const countText = `${PRODUCTS.length} ${PRODUCTS.length === 1 ? 'equipo' : 'equipos'} disponibles`
---

<BaseLayout title="PC's" description="Todos los equipos disponibles en PC Laptop.">
	<Catalog
		eyebrow="Catálogo"
		title="PC's"
		description="Todos los equipos disponibles, con su ficha técnica completa."
		countText={countText}
		filtersLabel="Filtros de productos"
		filtersNote="Marca, procesador, memoria y rango de precio llegan en la siguiente entrega."
	>
		{
			PRODUCTS.map((product) => (
				<ProductCard product={product} />
			))
		}
	</Catalog>
</BaseLayout>
