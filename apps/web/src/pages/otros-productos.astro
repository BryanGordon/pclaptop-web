---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ProductCard from '../components/ProductCard.astro';
import { OTHER_CATEGORIES, OTHER_PRODUCTS, getCategoryProducts } from '../data/other-products';

const countText = (count: number) => `${count} ${count === 1 ? 'producto' : 'productos'}`;
---

<BaseLayout title="Otros productos" description="Monitores, componentes, impresoras y repuestos.">
	<PageHeader
		eyebrow="Catálogo"
		title="Otros productos"
		description="Explora por categoría y encuentra lo que necesitas para completar tu equipo."
	/>

	<div class="container other">
		<section aria-labelledby="other-categories-title">
			<header class="section__header">
				<div class="other__intro">
					<p class="eyebrow">Categorías</p>
					<h2 id="other-categories-title">Explora por categoría</h2>
				</div>
			</header>

			<ul class="categories">
				{
					OTHER_CATEGORIES.map((category) => (
						<li>
							<a class="card card--glow category" href={`/otros-productos/${category.slug}`}>
								<h3>{category.label}</h3>
								<p>{category.description}</p>
								<span class="category__count">
									{countText(getCategoryProducts(category.slug).length)}
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<section aria-labelledby="other-products-title">
			<header class="section__header">
				<div class="other__intro">
					<p class="eyebrow">Catálogo completo</p>
					<h2 id="other-products-title">Todos los productos</h2>
				</div>
				<p class="other__count">{countText(OTHER_PRODUCTS.length)}</p>
			</header>

			<div class="others">
				{
					OTHER_PRODUCTS.map((product) => (
						<ProductCard product={product} layout="row" headingLevel={3} />
					))
				}
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	.other {
		display: grid;
		gap: var(--section-space);
		padding-bottom: var(--section-space);
	}

	.other .section__header {
		margin-bottom: var(--gap);
	}

	.other__intro {
		display: grid;
		gap: 12px;
	}

	.other__count {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}

	.categories {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--gap);
	}

	.category {
		gap: 8px;
		height: 100%;
		padding: 28px 24px;
	}

	.category h3 {
		font-size: var(--text-lg);
	}

	.category p {
		font-size: var(--text-sm);
		opacity: 0.85;
	}

	.category__count {
		margin-top: auto;
		padding-top: 12px;
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		opacity: 0.7;
	}

	.others {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--gap);
	}
</style>
