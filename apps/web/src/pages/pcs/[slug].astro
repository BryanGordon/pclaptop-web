---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductDetail from '../../components/ProductDetail.astro';
import { PRODUCTS, type Product } from '../../data/products';

export function getStaticPaths() {
	return PRODUCTS.map((product) => ({
		params: { slug: product.slug },
		props: { product },
	}));
}

const { product } = Astro.props as { product: Product };
---

<BaseLayout
	title={product.model}
	description={`${product.model}: ficha técnica y precio en PC Laptop.`}
>
	<ProductDetail
		model={product.model}
		price={product.price}
		specs={product.specs}
		image={product.image}
		imageAlt={product.imageAlt}
		trail={[
			{ label: 'Inicio', href: '/' },
			{ label: "PC's", href: '/pcs' },
			{ label: product.model },
		]}
		backHref="/pcs"
		backLabel="Volver al catálogo"
	/>
</BaseLayout>
